{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "com.akashjose.Subixa.metainfo.xml"
      ]
    }
  },
  "include-component-in-tag": false,
  "tag-separator": "-",
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "pull-request-header": "The release PR. Merging it tags the version, publishes the release, and starts the build that attaches the downloads.",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "build", "section": "Build and packaging" },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ]
}
