# build/ is the Linux tree; the others keep a Windows build and the Release
# tree tools/install-linux.sh makes from overwriting it when all are made from
# the same checkout.
build/
build-rel/
build-win/
dist/
.cache/
compile_commands.json
*.user
*.autosave
.qtc_clangd/
CMakeLists.txt.user*

# Where tools/render-canary.sh leaves the grabs and the log when it fails.
canary-failure/

# Agent scratch space. Worktrees created here are separate git checkouts, and
# `git add -A` will otherwise stage them as embedded repositories.
.claude/

# Generated test media. testclip.mp4 is 15 s of testsrc2 with a burned-in
# timecode, and testdata/make-fixtures.sh generates it along with everything
# muxed from it.
testclip.mp4

# Generated subtitle fixtures -- rebuild with testdata/make-fixtures.sh.
# Only the small .srt/.ass sources are tracked.
testdata/*.mkv
testdata/*.mp4
testdata/sidecar.*
testdata/huge.en.ass

# The conformance corpus is the opposite: committed as bytes, so that every
# platform decodes identical input rather than whatever its own ffmpeg muxed.
# The patterns above do not reach it -- they match direct children of testdata/
# only -- but that is an accident of glob depth, and this says so out loud.
!testdata/conformance/**

# Test artefacts copied next to testclip.mp4 while checking the browser.
testclip.*.srt

# ctest's own scratch: cost data and the last run's log. It lands under the
# directory ctest was invoked from, so a run started at the top of the tree
# leaves it here rather than inside build/, which is already ignored.
Testing/

# aqtinstall drops this wherever it is run from.
aqtinstall.log
