[Desktop Entry]
Type=Application
Name=Subixa Player
GenericName=Media Player
Comment=Watch films with a docked, searchable subtitle browser
Exec=subixa %F
Icon=subixa
Terminal=false
# The window's WM_CLASS, for shells that match on it rather than the entry name.
StartupWMClass=subixa
Categories=AudioVideo;Video;Player;
MimeType=video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/mpeg;video/x-flv;video/3gpp;video/ogg;application/x-matroska;
Keywords=video;movie;film;subtitle;subtitles;player;
